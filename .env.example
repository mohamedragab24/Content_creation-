# انسخ هذا الملف إلى .env محليًا، أو أضف القيم في لوحة Environment Variables للاستضافة.
PORT=3000
NODE_ENV=development
DEMO_MODE=false

# قبل استخدام التطبيق فعليًا: اجعل DEMO_MODE=false وغيّر القيم السرية التالية.
ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-UNIQUE-PASSWORD
SESSION_SECRET=CHANGE-THIS-TO-A-RANDOM-SECRET-AT-LEAST-32-CHARS
SETTINGS_ENCRYPTION_KEY=CHANGE-THIS-TO-A-DIFFERENT-RANDOM-SECRET-32-CHARS
DATA_DIR=data

# مفاتيح الذكاء الاصطناعي (اختياري: يمكن إدخال مفاتيح OpenAI/Gemini من الإعدادات بعد تسجيل الدخول).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MANUS_API_KEY=
MANUS_API_BASE=

# بيانات تطبيقات OAuth للمنصات الاجتماعية؛ يلزم إعداد Redirect URI والموافقة على الصلاحيات في كل منصة.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
OAUTH_CALLBACK_BASE_URL=https://YOUR-DOMAIN.example

# ضع false في الإنتاج. لا ترفع ملف .env أو مجلد data إلى مستودع عام.
