# Required in production; absent DATABASE_URL enables local in-memory demo data.
DATABASE_URL=postgresql://user:password@localhost:5432/souqna
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
CORS_ORIGIN=
# Optional Firebase Cloud Messaging server credentials belong on the server only.
FCM_PROJECT_ID=
# Optional cloud object-storage integration (never expose secrets in Flutter apps).
STORAGE_PROVIDER=
STORAGE_BUCKET=
